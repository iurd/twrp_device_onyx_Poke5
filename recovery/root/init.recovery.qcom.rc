on init
    # Required by Android FBE key installation. Without this, metadata
    # decryption can appear to succeed while /data still cannot mount.
    install_keyring
    # Poke5 frontlight is exposed through the Onyx white/cold channel. The
    # generic panel backlight nodes accept writes but do not drive the LEDs.
    write /sys/class/backlight/onyx_bl_br/brightness 14
    write /sys/class/backlight/onyx_bl_ct/brightness 0
    setprop sys.usb.configfs 1

on property:ro.boot.usbcontroller=*
    setprop sys.usb.controller ${ro.boot.usbcontroller}
    write /sys/class/udc/${ro.boot.usbcontroller}/device/../mode peripheral

on fs
    wait /dev/block/platform/soc/${ro.boot.bootdevice}
    symlink /dev/block/platform/soc/${ro.boot.bootdevice} /dev/block/bootdevice

    # Mount /metadata before fscrypt reads the metadata key.
    wait /dev/block/bootdevice/by-name/metadata
    mount ext4 /dev/block/bootdevice/by-name/metadata /metadata

# Poke5 userdata uses metadata encryption with hardware-wrapped keys. TWRP
# mounts stock /vendor immediately before decryption and then starts these
# vendor HALs so fscrypt can unwrap the metadata key through Qualcomm Keymaster.
# Vendor rc files are parsed too late for this recovery flow, so mirror the
# needed services here with recovery labels and permissive library paths.
service poke5-qseecomd /vendor/bin/qseecomd
    user root
    group root
    setenv LD_LIBRARY_PATH /system_root/system/apex/com.android.art.release/lib64:/apex/com.android.art.release/lib64:/system_root/system/lib64:/system_root/system/lib:/vendor/lib64:/vendor/lib:/system_ext/lib64:/system_ext/lib:/product/lib64:/product/lib:/system/lib64:/system/lib
    disabled
    oneshot
    seclabel u:r:recovery:s0

service poke5-keymaster /vendor/bin/hw/android.hardware.keymaster@4.1-service-qti
    interface android.hardware.keymaster@4.0::IKeymasterDevice default
    interface android.hardware.keymaster@4.1::IKeymasterDevice default
    user root
    group root system drmrpc
    setenv LD_LIBRARY_PATH /system_root/system/apex/com.android.art.release/lib64:/apex/com.android.art.release/lib64:/system_root/system/lib64:/system_root/system/lib:/vendor/lib64:/vendor/lib:/system_ext/lib64:/system_ext/lib:/product/lib64:/product/lib:/system/lib64:/system/lib
    disabled
    oneshot
    seclabel u:r:recovery:s0
