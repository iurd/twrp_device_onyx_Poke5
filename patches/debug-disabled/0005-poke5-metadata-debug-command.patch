+int TWPartitionManager::Poke5_Debug_Metadata_Decrypt(bool MountData) {
+#ifdef TW_INCLUDE_CRYPTO
+#ifdef TW_INCLUDE_FBE_METADATA_DECRYPT
+#ifdef USE_FSCRYPT
+	LOGINFO("Poke5 metadata debug: start mount_data=%d\n", MountData ? 1 : 0);
+	TWPartition* Decrypt_Data = Find_Partition_By_Path("/data");
+	if (!Decrypt_Data) {
+		LOGERR("Poke5 metadata debug: /data partition not found\n");
+		return -1;
+	}
+	LOGINFO("Poke5 metadata debug: data actual='%s' mount='%s' keydir='%s' fs='%s' encrypted=%d decrypted=%d fbe=%d\n",
+			Decrypt_Data->Actual_Block_Device.c_str(), Decrypt_Data->Mount_Point.c_str(),
+			Decrypt_Data->Key_Directory.c_str(), Decrypt_Data->Current_File_System.c_str(),
+			Decrypt_Data->Is_Encrypted ? 1 : 0, Decrypt_Data->Is_Decrypted ? 1 : 0,
+			Decrypt_Data->Is_FBE ? 1 : 0);
+
+	TWPartition* Key_Directory_Partition = Find_Partition_By_Path(Decrypt_Data->Key_Directory);
+	if (Key_Directory_Partition != nullptr && !Key_Directory_Partition->Is_Mounted()) {
+		LOGINFO("Poke5 metadata debug: mounting key directory '%s'\n", Decrypt_Data->Key_Directory.c_str());
+		Mount_By_Path(Decrypt_Data->Key_Directory, false);
+	}
+
+	bool poke5_metadata_mounted = Mount_By_Path("/metadata", false);
+	bool poke5_system_mounted = Mount_By_Path("/system_root", false);
+	if (!poke5_system_mounted)
+		poke5_system_mounted = Mount_By_Path("/system", false);
+	bool poke5_vendor_mounted = Mount_By_Path("/vendor", false);
+	LOGINFO("Poke5 metadata debug: mounts metadata=%d system=%d vendor=%d\n",
+			poke5_metadata_mounted ? 1 : 0, poke5_system_mounted ? 1 : 0, poke5_vendor_mounted ? 1 : 0);
+
+	android::base::SetProperty("ctl.start", "poke5-qseecomd");
+	usleep(1000000);
+	// Keep the existing hwservicemanager alive. Restarting it right before
+	// fscrypt can make Keymaster's ServiceManager lookup abort in recovery.
+	android::base::SetProperty("ctl.start", "poke5-keymaster");
+	android::base::SetProperty("ctl.start", "poke5-gatekeeper");
+	android::base::SetProperty("ctl.start", "poke5-boot-hal");
+	usleep(2000000);
+	LOGINFO("Poke5 metadata debug: services qsee=%s keymaster=%s gatekeeper=%s hwservicemanager=%s\n",
+			android::base::GetProperty("init.svc.poke5-qseecomd", "").c_str(),
+			android::base::GetProperty("init.svc.poke5-keymaster", "").c_str(),
+			android::base::GetProperty("init.svc.poke5-gatekeeper", "").c_str(),
+			android::base::GetProperty("init.svc.hwservicemanager", "").c_str());
+
+	Set_Crypto_State();
+	Set_Crypto_Type("file");
+	LOGINFO("Poke5 metadata debug: before fscrypt blk='%s' mount='%s' old_crypto_blkdev='%s'\n",
+			Decrypt_Data->Actual_Block_Device.c_str(), Decrypt_Data->Mount_Point.c_str(),
+			android::base::GetProperty("ro.crypto.fs_crypto_blkdev", "").c_str());
+
+	bool ok = fscrypt_mount_metadata_encrypted(Decrypt_Data->Actual_Block_Device, Decrypt_Data->Mount_Point, false);
+	std::string crypto_blkdev = android::base::GetProperty("ro.crypto.fs_crypto_blkdev", "error");
+	LOGINFO("Poke5 metadata debug: after fscrypt ok=%d crypto_blkdev='%s'\n", ok ? 1 : 0, crypto_blkdev.c_str());
+	if (!ok || crypto_blkdev.empty() || crypto_blkdev == "error") {
+		LOGERR("Poke5 metadata debug: metadata decrypt failed or returned invalid block device\n");
+		return -1;
+	}
+
+	Decrypt_Data->Decrypted_Block_Device = crypto_blkdev;
+	Decrypt_Data->Is_Decrypted = true;
+	if (MountData) {
+		LOGINFO("Poke5 metadata debug: trying to mount decrypted /data\n");
+		int retry_count = 10;
+		while (!Decrypt_Data->Mount(false) && --retry_count)
+			usleep(500);
+		if (!Decrypt_Data->Mount(false)) {
+			LOGERR("Poke5 metadata debug: failed to mount /data after metadata decrypt\n");
+			return -1;
+		}
+		LOGINFO("Poke5 metadata debug: /data mounted after metadata decrypt\n");
+	}
+	return 0;
+#else
+	LOGERR("Poke5 metadata debug: USE_FSCRYPT not enabled\n");
+	return -1;
+#endif
+#else
+	LOGERR("Poke5 metadata debug: TW_INCLUDE_FBE_METADATA_DECRYPT not enabled\n");
+	return -1;
+#endif
+#else
+	LOGERR("Poke5 metadata debug: TW_INCLUDE_CRYPTO not enabled\n");
+	return -1;
+#endif
+}
