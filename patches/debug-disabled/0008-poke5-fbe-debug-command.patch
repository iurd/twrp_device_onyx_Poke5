+int TWPartitionManager::Poke5_Debug_FBE_Decrypt(bool UnlockDefault) {
+#ifdef TW_INCLUDE_CRYPTO
+#ifdef TW_INCLUDE_FBE
+#ifdef USE_FSCRYPT
+	TWPartition* data = Find_Partition_By_Path("/data");
+	if (data == nullptr || !data->Is_Mounted()) {
+		LOGERR("Poke5 FBE debug: /data is not mounted\n");
+		return -1;
+	}
+	LOGINFO("Poke5 FBE debug: loading system and user DE keys\n");
+	bool de_ok = Decrypt_DE();
+	LOGINFO("Poke5 FBE debug: Decrypt_DE result=%d\n", de_ok ? 1 : 0);
+	if (!de_ok)
+		return -1;
+	Parse_Users();
+	if (!UnlockDefault)
+		return 0;
+	LOGINFO("Poke5 FBE debug: loading user 0 CE key with default credential\n");
+	bool ce_ok = Decrypt_User(0, "!");
+	LOGINFO("Poke5 FBE debug: Decrypt_User(0, default) result=%d\n", ce_ok ? 1 : 0);
+	return ce_ok ? 0 : -1;
+#else
+	LOGERR("Poke5 FBE debug: USE_FSCRYPT not enabled\n");
+#endif
+#else
+	LOGERR("Poke5 FBE debug: TW_INCLUDE_FBE not enabled\n");
+#endif
+#else
+	LOGERR("Poke5 FBE debug: TW_INCLUDE_CRYPTO not enabled\n");
+#endif
+	return -1;
+}
